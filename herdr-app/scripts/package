#!/bin/bash
# Builds a release of the Herdr2 desktop app and packs it:
#
#   scripts/package                        -> dist/herdr2-<os>-<arch>.tar.gz
#   scripts/package <triple>               -> cross-compiled target archive
#
# Linux: a folder `herdr2/` holding `herdr2` and `herdr2.svg`.
# macOS: `Herdr2.app`, signed with APPLE_CERTIFICATE_P12 when available,
# otherwise ad hoc.
# Windows (native or Linux cargo-xwin cross-compile): `herdr2/` holding
# `herdr2.exe` and `herdr2.svg`.
# Optional env: HERDR2_DEFAULT_RELEASES_URL bakes a default release server URL.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
host_os=$(uname -s)
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$host_os" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $host_os" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
target="$os-$arch"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: herdr2 $version for $target"
for notice in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# Only release builds auto-update themselves by default (src/update.rs).
if [[ $host_os == Linux && $os == windows && -n $triple ]]; then
  ZIG="${ZIG:-$(cd .. && pwd)/scripts/zig-xwin.sh}" HERDR2_APP_RELEASE=1 cargo xwin build --release --locked --target "$triple"
else
  HERDR2_APP_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}
fi

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/herdr2-$target.tar.gz"
if [[ $os == linux || $os == windows ]]; then
  dir="$work/herdr2"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then
    cp "$bin/herdr2.exe" "$dir/"
    [[ -f assets/icons/herdr-app.ico ]] && cp assets/icons/herdr-app.ico "$dir/herdr2.ico"
  else
    cp "$bin/herdr2" "$dir/"
  fi
  cp assets/icons/herdr-ui-icon-clean.svg "$dir/herdr2.svg"
  [[ -f assets/icons/herdr-ui-icon-clean.png ]] && cp assets/icons/herdr-ui-icon-clean.png "$dir/herdr2.png"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  notices_path=herdr2/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" herdr2
else
  app="$work/Herdr2.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/herdr2" "$app/Contents/MacOS/Herdr2"
  cp assets/icons/Herdr.icns "$app/Contents/Resources/Herdr2.icns"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  notices_path=Herdr2.app/Contents/Resources/THIRD-PARTY-NOTICES
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr2</string>
    <key>CFBundleIdentifier</key><string>dev.herdr2.app</string>
    <key>CFBundleName</key><string>Herdr2</string>
    <key>CFBundleDisplayName</key><string>Herdr2</string>
    <key>CFBundleIconFile</key><string>Herdr2</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr2 can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr2 can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr2 can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
  scripts/mac-sign "$app"
  tar -czf "$out" -C "$work" Herdr2.app
fi
tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
echo "package: $out ($(sha256 "$out"))"
